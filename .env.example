# Copy to .env (loaded automatically; real environment variables win).
ANTHROPIC_API_KEY=

# heuristic = offline regex extractor (default) · anthropic = Claude extractor (use on the day)
HOLDOUT_LLM=heuristic
HOLDOUT_MODEL=claude-sonnet-5-5

# 1 = OCR pages with no text layer (needs tesseract + poppler); slow, try a subset first
HOLDOUT_OCR=0

# 1 = ask Claude to confirm each flag against its pages before reporting (one call per flag)
HOLDOUT_VERIFY_LLM=0

# Characters of filing text per extraction call
HOLDOUT_CHUNK_CHARS=60000

# Optional GXL Paperclip sponsor resource; public-source research only
PAPERCLIP_API_KEY=

# Optional second model provider for eval runs
OPENAI_API_KEY=
